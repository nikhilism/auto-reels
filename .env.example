# ─────────────────────────────────────────────
#  AUTO REELS — Environment Variables Template
#  Copy this file to .env and fill in your keys
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API Key (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API v3 (optional — only needed when auto_upload: true)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Jamendo Music API (optional — for royalty-free background music)
# Free registration at: https://developer.jamendo.com/v3.0
# If not set, uses curated CDN fallback tracks automatically
JAMENDO_CLIENT_ID=your_jamendo_client_id_here
